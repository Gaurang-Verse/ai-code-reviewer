# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file (it's already in .gitignore).

# A GitHub personal access token with repo + pull-request scopes.
GITHUB_TOKEN=

# A Google AI Studio / Gemini API key.
GOOGLE_API_KEY=

# Optional overrides:
# GEMINI_MODEL=gemini-2.0-flash
# MAX_RETRIES=3
# BASE_RETRY_WAIT_SECONDS=30
